NODE_ENV=development
PORT=3000
# For Supabase, use the Session Pooler connection string from Dashboard > Connect (port 5432).
# Keep the database password in your local .env file; never commit it.
DATABASE_URL="postgresql://postgres:password@localhost:5432/pixo?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
FRONTEND_ORIGIN="http://localhost:3001"
